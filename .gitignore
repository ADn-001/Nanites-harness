node_modules/

# Local Cortex (Needle + Laya) runtime state — never commit machine-specific values.
# The ledger holds redacted repair/decision traces; model caches live outside the repo
# (~/.cache/cactus-needle, ~/.cache/receptron-laya) by default.
var/
localmodels/.venv/
localmodels/node_modules/
localmodels/.cache/
localmodels/*.cact
localmodels/.localmodels-env

# Python bytecode: importing localmodels/ledger.py writes a .pyc next to it, and this
# repo is share-ready — bytecode must never be tracked.
__pycache__/
*.py[cod]

# Daemon runtime logs. bridge_daemon.log was tracked by accident in phase 7/8 and
# only ever accumulated e2e-harness churn; no code reads it. `git rm --cached` so the
# file stays on disk (the daemon appends to it) while the repo stops carrying it.
*.log

# PHASE 19: the per-install daemon auth tokens. These are SECRETS (32+ bytes of
# entropy, mode 0600) that the operator pastes into the UI once. Each server creates
# its own next to itself, so both paths are ignored — committing either one would
# hand every checkout of this repo a working privileged token.
.cogitator-token
localmodels/.cogitator-token
